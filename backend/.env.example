# Copy to backend/.env for local (non-Docker) development.
# Inside Docker these are supplied by docker-compose.yml.

# Host ports from docker-compose.yml (Postgres 5434, Redis 6380)
DATABASE_URL=postgresql://saiv:saiv_password@localhost:5434/saiv
REDIS_URL=redis://localhost:6380/0
FACE_SERVICE_URL=http://localhost:8001

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-key-change-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=10

# Face service call budgets. The check-in path is tight so the whole request
# stays under 2 s; after a connection failure the check-in path skips the
# service for FACE_SERVICE_COOLDOWN_SECONDS (circuit breaker).
FACE_SERVICE_TIMEOUT=5.0
FACE_CHECKIN_TIMEOUT=1.5
FACE_RISK_ASSESS_ENABLED=true
FACE_RISK_TIMEOUT=0.75
FACE_SERVICE_COOLDOWN_SECONDS=30

# Risk decision: >= RISK_SCORE_THRESHOLD flags for review,
# >= RISK_REJECT_THRESHOLD (CRITICAL band) rejects outright.
RISK_SCORE_THRESHOLD=0.5
RISK_REJECT_THRESHOLD=0.7
LIVENESS_THRESHOLD=0.6
FACE_MATCH_THRESHOLD=0.7

# 30-day retention: the sweep anonymises users and scrubs check-in location
# data once scheduled_deletion_at passes. POST /admin/retention/purge runs it
# on demand.
DATA_RETENTION_DAYS=30
RETENTION_SWEEP_ENABLED=true
RETENTION_SWEEP_INTERVAL_SECONDS=3600

# Sessions: rotating QR codes for replay prevention, and how far in the past
# a "future" scheduled_start may be to absorb clock skew.
QR_CODE_TTL_SECONDS=300
SESSION_START_GRACE_SECONDS=300

# Registration is intentionally permissive by default: the public test suite
# creates far more than 10 accounts per run from one IP.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_HOUR=60
RATE_LIMIT_API_PER_HOUR=1000
RATE_LIMIT_CHECKIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=1000

CORS_ORIGINS=http://localhost:3000,http://localhost:8501
DEBUG=false
